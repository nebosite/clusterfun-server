# clusterfun-server secrets — EXAMPLE / TEMPLATE (safe to commit; no real values here).
#
# Copy this to `.env` beside it and fill in real values:
#
#     cp example.env .env
#     chmod 600 .env
#
# `.env` is gitignored. The server loads it at startup from its own folder, then the folder
# above it — so `clusterfun-server/.env` is picked up whether it is running from `src/`
# (npm run startdev) or `dist/` (npm start). In production the server runs out of ~/deploy,
# so the file goes at `~/deploy/.env`.
#
# Anything already set in the real environment WINS over this file, so exporting a variable
# on the command line or from systemd still overrides it.
#
# CLUSTERFUN_ENV_FILE=/some/other/path.env overrides the location entirely.

# YouTube Data API key for the /api/youtube_search proxy behind Pass the AUX.
# Without it, song search returns no results (the game still loads).
YOUTUBE_API_KEY=replace-with-real-key

# Optional cache tuning for that proxy (defaults: 24h TTL, 500 entries):
# YT_CACHE_TTL_MS=86400000
# YT_CACHE_MAX=500
